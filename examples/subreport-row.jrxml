<jasperReport name="SalesRow" language="java" pageWidth="515" pageHeight="842" columnWidth="515" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
  <parameter name="TITLE" class="java.lang.String"/>
  <field name="product" class="java.lang.String"/>
  <field name="quantity" class="java.lang.Integer"/>
  <field name="amount" class="java.math.BigDecimal"/>
  <detail><band height="25">
    <element kind="textField" x="0" y="0" width="270" height="22"><expression><![CDATA["Child: " + $F{product}]]></expression></element>
    <element kind="textField" x="280" y="0" width="90" height="22"><expression><![CDATA[$F{quantity}]]></expression></element>
    <element kind="textField" x="380" y="0" width="130" height="22" pattern="#,##0.00"><expression><![CDATA[$F{amount}]]></expression></element>
  </band></detail>
</jasperReport>
