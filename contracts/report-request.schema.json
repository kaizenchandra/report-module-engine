{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "definitionId",
        "definitionVersion",
        "parameters",
        "outputs",
        "destinationRef"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": ["1"]
        },
        "definitionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "definitionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000001
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
            },
            "locale": {
              "type": ["string", "null"],
              "enum": ["en-US", "de-DE", "fr-FR", null],
              "default": "en-US"
            },
            "timeZone": {
              "type": ["string", "null"],
              "enum": [
                "UTC",
                "Asia/Kolkata",
                "America/New_York",
                "Europe/Berlin",
                null
              ],
              "default": "UTC"
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "enum": ["PDF", "XLSX", "CSV", "DOCX", "HTML"]
          },
          "uniqueItems": true
        },
        "destinationRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "definitionId",
        "definitionVersion",
        "parameters",
        "outputs",
        "deliveries"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": ["2"]
        },
        "definitionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "definitionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000001
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
            },
            "locale": {
              "type": ["string", "null"],
              "enum": ["en-US", "de-DE", "fr-FR", null],
              "default": "en-US"
            },
            "timeZone": {
              "type": ["string", "null"],
              "enum": [
                "UTC",
                "Asia/Kolkata",
                "America/New_York",
                "Europe/Berlin",
                null
              ],
              "default": "UTC"
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": ["PDF", "XLSX", "CSV", "DOCX", "HTML"]
          },
          "uniqueItems": true
        },
        "optionalOutputs": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["PDF", "XLSX", "CSV", "DOCX", "HTML"]
          }
        },
        "deliveries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["destinationRef", "outputs", "required"],
            "properties": {
              "destinationRef": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,63}$"
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "enum": ["PDF", "XLSX", "CSV", "DOCX", "HTML"]
                },
                "uniqueItems": true
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "description": "Explicit mappings. Optional outputs must be selected outputs, with at least one required output. Every output must have a mapping; each required output needs a required delivery. Required deliveries cannot depend on optional outputs. Duplicate destination/format pairs and physical targets are rejected. Backend enforces cross-field rules."
    }
  ]
}
