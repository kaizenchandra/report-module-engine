# Generate actual local-only values with scripts/local-env.sh. Do not commit credentials.
DATABASE_PASSWORD=
OIDC_CLIENT_SECRET=
REPORT_TEST_PASSWORD=
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3005
CORE_URL=http://localhost:8085
# Optional core overrides:
# DATABASE_URL=jdbc:postgresql://localhost:5432/report_core
# DATABASE_USER=report_core
# OIDC_ISSUER=http://localhost:8180/realms/reporting
PORT=8085
# Local delivery credentials generated by scripts/local-env.sh:
DELIVERY_CLIENT_SECRET=
DELIVERY_DATABASE_PASSWORD=
S3_LOCAL_SECRET=
# Set by scripts/delivery.sh for local execution:
# DELIVERY_DATABASE_URL=postgres://delivery:REDACTED@localhost:5433/delivery?sslmode=disable
# DELIVERY_TOKEN_URL=http://localhost:8180/realms/reporting/protocol/openid-connect/token
# S3_BUCKET=report-results
# GCS_BUCKET=report-results
# S3_ENDPOINT=http://localhost:9000
# STORAGE_EMULATOR_HOST=http://localhost:4443
# AWS_REGION=us-east-1
# ARTIFACT_ROOT=.artifacts

# Optional private Go temporary upload directory (0700, no symlink):
# DELIVERY_SCRATCH_ROOT=/private/tmp/report-engine-delivery

# Loopback emulator only; default false outside generated local development:
REPORT_ALLOW_EMULATOR_LINKS=true
# Optional GCS IAM signer (delivery only); requires signBlob permission and Credentials API:
# GCS_SIGNING_SERVICE_ACCOUNT=report-signer@your-project.iam.gserviceaccount.com

# Local operator OIDC fixture; generated random development credential:
REPORT_ADMIN_TEST_PASSWORD=

# Explicit opt-in only when REPORT_ADMIN identities are trusted to execute Java code:
REPORT_TRUSTED_TEMPLATE_UPLOADS_ENABLED=false

# Deployment-owned PostgreSQL sales snapshot adapter. Empty host disables it.
# No connection configuration or credentials are accepted through browser APIs.
REPORT_JDBC_HOST=
REPORT_JDBC_PORT=5432
REPORT_JDBC_DATABASE=report_input
REPORT_JDBC_USERNAME=report_reader
REPORT_JDBC_PASSWORD=
REPORT_JDBC_SSL_MODE=verify-full
# Synthetic local fixture only; generated local settings use localhost:5434 and disable TLS.
JDBC_DATABASE_PASSWORD=
